# Copy this file to "keystore.properties" (same folder) and fill in your
# own values. keystore.properties is git-ignored — never commit it or the
# .jks/.keystore file. Keep both backed up somewhere safe: if you lose
# them you can NEVER update this app again on devices that have it
# installed — you'd have to uninstall it first, losing local data.
storeFile=cmdrsys-release.keystore
storePassword=CHANGE_ME
keyAlias=cmdrsys
keyPassword=CHANGE_ME
